---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
}

const { title = SITE.title, description = SITE.description, image, type } = Astro.props;
const fullTitle = title === SITE.title ? SITE.title : `${title} — ${SITE.title}`;
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title={fullTitle} description={description} image={image} type={type} />

		<!-- 在首屏渲染前确定主题，避免闪烁；用户手动选择过的优先 -->
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem('theme');
					var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					document.documentElement.dataset.theme = stored || (prefersDark ? 'dark' : 'light');
				} catch (e) {
					document.documentElement.dataset.theme = 'light';
				}
			})();
		</script>
	</head>
	<body>
		<Header />
		<main class="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
