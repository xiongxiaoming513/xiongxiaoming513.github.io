---
interface Props {
	date: Date;
	format?: 'long' | 'short';
}

const { date, format = 'long' } = Astro.props;

const formatted =
	format === 'short'
		? new Intl.DateTimeFormat('zh-CN', {
				year: 'numeric',
				month: '2-digit',
				day: '2-digit',
				timeZone: 'Asia/Shanghai',
			})
				.format(date)
				.replaceAll('/', '.')
		: new Intl.DateTimeFormat('zh-CN', {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
				timeZone: 'Asia/Shanghai',
			}).format(date);

const iso = date.toISOString();
---

<time datetime={iso}>{formatted}</time>
