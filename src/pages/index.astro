---
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedPosts, getTags } from '../lib/posts';

const posts = await getSortedPosts();
const latest = posts.slice(0, 5);
const tags = (await getTags()).slice(0, 8);
---

<BaseLayout>
	<section class="wrap hero">
		<p class="hero__eyebrow">随笔 · 笔记 · 记录</p>
		<h1>{SITE.author}</h1>
		<p class="hero__tagline">{SITE.tagline}</p>
		<div class="social">
			{
				SITE.social.map((item) => (
					<a href={item.href} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
						{item.label}
					</a>
				))
			}
		</div>
	</section>

	<section class="wrap section">
		<h2 class="section-label">最近文章</h2>
		<ul class="post-list">
			{latest.map((post) => <PostCard post={post} />)}
		</ul>
		<a class="more-link" href="/blog/">全部 {posts.length} 篇 →</a>
	</section>

	{
		tags.length > 0 && (
			<section class="wrap section">
				<h2 class="section-label">常写的话题</h2>
				<ul class="tag-cloud">
					{tags.map(({ tag, count }) => (
						<li>
							<a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
								{tag}
								<span class="tag-count">{count}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section class="wrap section">
		<a class="home-entry" href="/archive/">
			<span class="home-entry__label">归档</span>
			<span class="home-entry__desc">按时间线浏览全部 {posts.length} 篇文章</span>
			<span class="home-entry__arrow" aria-hidden="true">→</span>
		</a>
	</section>
</BaseLayout>
